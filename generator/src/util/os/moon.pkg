import {
  "moonbitlang/x/os" @unix,
  "moonbitlang/x/os/fs" @unix/fs,
  "moonbitlang/x/os/process" @unix/process,
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
}

// The generic synchronous native surface lives in `moonbitlang/x/os`,
// with filesystem and process operations in its `fs` and `process` packages.
// This package retains Moon-specific platform/build policy plus compatibility
// wrappers for existing compiler call sites.

supported_targets = "native"

options(
  "native-stub": [ "os.c", "os_win.c" ],
)
