import {
  "moonbitlang/x/os" @unix,
  "moonbitlang/x/os/fs" @unix/fs,
  "moonbitlang/x/os/process" @unix/process,
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
}

// Filesystem and process operations come from `moonbitlang/x/os`.
// This package adapts their results for the generator's existing call sites.

supported_targets = "native"
