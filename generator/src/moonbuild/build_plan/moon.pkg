import {
  "moon/moonbuild/analysis/model",
  "moon/moonbuild/analysis/pkg_solve",
  "moon/util/cc",
  "moon/moonbuild/core",
  "moon/util/config",
  "moon/util/os",
  "moon/util/pathx",
  "moonbitlang/core/json",
